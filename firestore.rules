rules_version = '2';

// ============================================================================
//  Règles de sécurité Firestore — Luach Mivchanim
// ----------------------------------------------------------------------------
//  CONTEXTE : l'app web (Firebase Hosting + React) parle DIRECTEMENT à Firestore
//  depuis le navigateur. Ces règles sont donc tout le périmètre de sécurité —
//  il n'y a plus de backend qui filtre.
//
//  L'ancienne app Python (Admin SDK) CONTOURNE ces règles : la déployer ne casse
//  donc rien côté Streamlit. Le changement est purement additif.
//
//  Principe : personne n'accède à une école sans en être propriétaire ou y avoir
//  une fiche de permission. Aucun accès anonyme.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner(schoolId) {
      return signedIn()
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.owner_email == userEmail();
    }

    function hasPermissionDoc(schoolId) {
      return signedIn()
        && exists(/databases/$(database)/documents/schools/$(schoolId)/permissions/$(userEmail()));
    }

    function permissionRole(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)/permissions/$(userEmail())).data.role;
    }

    // Peut ouvrir l'école (directeur ou enseignant invité).
    function isMember(schoolId) {
      return isOwner(schoolId) || hasPermissionDoc(schoolId);
    }

    // Peut administrer l'école (propriétaire, ou invité avec le rôle directeur).
    function isDirector(schoolId) {
      return isOwner(schoolId)
        || (hasPermissionDoc(schoolId) && permissionRole(schoolId) == 'director');
    }

    // Index des invitations : chacun ne lit que SA propre fiche.
    // L'écriture reste réservée au backend (Admin SDK), qui contourne ces règles.
    match /user_schools/{docEmail} {
      allow read: if signedIn() && docEmail == userEmail();
      allow write: if false;
    }

    match /schools/{schoolId} {
      allow read:   if isMember(schoolId);
      allow update: if isDirector(schoolId);
      // On ne peut créer qu'une école dont on est soi-même propriétaire.
      allow create: if signedIn() && request.resource.data.owner_email == userEmail();
      allow delete: if false;

      // Le calendrier : les enseignants aussi doivent pouvoir saisir des examens.
      match /schedule_meta/{docId} {
        allow read, write: if isMember(schoolId);
      }
      match /classes/{classId} {
        allow read, write: if isMember(schoolId);
      }

      // Données ministère de l'école : lecture pour tous, écriture aux directeurs.
      match /ministry_data/{examCode} {
        allow read:  if isMember(schoolId);
        allow write: if isDirector(schoolId);
      }

      // Gestion du personnel : lecture pour les membres, écriture aux directeurs.
      match /permissions/{permEmail} {
        allow read:  if isMember(schoolId);
        allow write: if isDirector(schoolId);
      }
    }

    // Données nationales (fêtes, bagrouйот) : lecture pour tout compte connecté,
    // écriture réservée au backend.
    match /global_holidays/{year} {
      allow read:  if signedIn();
      allow write: if false;
    }
    match /global_ministry_data/{examCode} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // Tout le reste est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
